// Prisma schema — Phase 2 infrastructure foundation.
//
// No domain models yet. Domain schema (Hospital, Patient, Encounter, ...) is
// intentionally deferred until the tenant field convention is decided:
// see docs/DATABASE_SCHEMA.md and docs/ARCHITECTURE_DECISIONS_PENDING.md (ADP-004).
//
// Commands (run from the repository root):
//   pnpm db:generate         generate Prisma Client for apps/api
//   pnpm db:migrate:deploy   apply committed migrations
//   pnpm db:migrate:status   show migration status

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
