# Hospital System — Environment Template
#
# Generate a local `.env` with random development secrets:
#   pnpm env:init
# Never commit `.env`. Values left empty here are secrets and MUST be set locally.
# Passwords used inside URLs must be URL-safe (the init script generates hex values).

NODE_ENV=development

# ---------------------------------------------------------------------------
# Apps
# ---------------------------------------------------------------------------
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Server-side API URL used by the web app (container-to-container in Docker).
API_INTERNAL_BASE_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------------------------
# PostgreSQL 17 (docker compose service: postgres)
# ---------------------------------------------------------------------------
POSTGRES_DB=hospital
POSTGRES_USER=hospital
POSTGRES_PASSWORD=
# Host port 5433 avoids clashing with a native Windows PostgreSQL service on 5432.
# Inside Docker the api always uses postgres:5432.
POSTGRES_HOST_PORT=5433
# Host development connection (API running on the host via pnpm).
DATABASE_URL=postgresql://hospital:<POSTGRES_PASSWORD>@127.0.0.1:5433/hospital?schema=public

# ---------------------------------------------------------------------------
# Redis (docker compose service: redis)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_HOST_PORT=6379
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# MinIO object storage (docker compose service: minio)
# ---------------------------------------------------------------------------
# Administrative root account — used only by the minio-init job, never by the API.
MINIO_ROOT_USER=hospital-admin
MINIO_ROOT_PASSWORD=
# Least-privilege application account, restricted to MINIO_BUCKET.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=hospital-app
MINIO_SECRET_KEY=
MINIO_BUCKET=hospital-local
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---------------------------------------------------------------------------
# Auth & session (Phase 3). Defaults match AUTHENTICATION_AUTHORIZATION.md.
# SESSION_COOKIE_SECURE is required true when NODE_ENV=production.
# ---------------------------------------------------------------------------
AUTH_PROVIDER=local
AUTH_MFA_MODE=disabled
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_PER_IP=100
AUTH_RATE_LIMIT_MAX_PER_USERNAME=20
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_LIFETIME_HOURS=12
SESSION_COOKIE_SECURE=true
TRUST_PROXY=loopback

APP_NAME=Hospital System
LOG_LEVEL=info
