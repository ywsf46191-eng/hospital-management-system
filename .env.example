# Hospital System — Environment Template
# Copy to `.env` for local development. Never commit real secrets.

NODE_ENV=development

# Apps
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Database (PostgreSQL) — structural placeholder only in Phase 0/1
DATABASE_URL=postgresql://hospital:hospital@localhost:5432/hospital?schema=public

# Redis — structural placeholder only
REDIS_URL=redis://localhost:6379

# Object storage (MinIO) — structural placeholder only
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=hospital
MINIO_USE_SSL=false

# Auth — NOT implemented in Phase 0/1 (see docs/ARCHITECTURE_DECISIONS_PENDING.md ADP-003)
# AUTH_PROVIDER=pending
# KEYCLOAK_URL=
# KEYCLOAK_REALM=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=

# App
APP_NAME=Hospital System
LOG_LEVEL=info
